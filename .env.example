DATABASE_URL=postgresql+asyncpg://argos:change-me@localhost:5432/argos
SERVICE_NAME=argos-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com
BINANCE_CONNECT_TIMEOUT_SECONDS=5
BINANCE_READ_TIMEOUT_SECONDS=10
BINANCE_INGESTION_LIMIT=12
ML_SCREENING_THREAD_COUNT=2
CORS_ALLOWED_ORIGINS=http://localhost:4200
ARGOS_AUTH_ENFORCEMENT_ENABLED=false
ARGOS_ADMIN_USERNAME=admin
ARGOS_ADMIN_PASSWORD_HASH=$argon2id$replace-with-generated-hash
ARGOS_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
ARGOS_SESSION_LIFETIME_MINUTES=480
ARGOS_AUTH_COOKIE_SECURE=false
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=change-me
